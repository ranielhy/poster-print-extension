{
  "manifest_version": 3,
  "name": "Poster Print",
  "description": "Divide imagens para impressão em múltiplas páginas.",
  "version": "1.0.0",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Poster Print"
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_start_mellowtel.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}