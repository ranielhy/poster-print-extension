{
  "manifest_version": 3,
  "name": "Poster Print",
  "description": "Divide imagens para impressão em múltiplas páginas.",
  "version": "1.0.0",

  "action": {
    "default_title": "Poster Print"
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}